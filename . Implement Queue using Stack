class StackQueue {
public:
 stack<int> st;
    stack<int> st1;
    StackQueue() {
    }
    
    void push(int x) {
    int n = st.size();
        while(!st.empty()){
            st1.push(st.top());
            st.pop();
        }
        st.push(x);
        while(!st1.empty()){
             st.push(st1.top());
            st1.pop();
        }
    }
    
    int pop() {
         int ans = st.top();
       st.pop();
       return ans; 
    }
    
    int peek() {
     return st.top();
    }
    
    bool isEmpty() {
   return st.empty();
    }
};
