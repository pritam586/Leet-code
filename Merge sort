class Solution {
public:
    void combine(vector<int>& nums, int low, int mid, int high) {
        vector<int> temp;

        int i = low;
        int j = mid + 1;

        while (i <= mid && j <= high) {
            if (nums[i] <= nums[j]) {
                temp.push_back(nums[i]);
                i++;
            } else {
                temp.push_back(nums[j]);
                j++;
            }
        }

        // Remaining elements from left half
        while (i <= mid) {
            temp.push_back(nums[i]);
            i++;
        }

        // Remaining elements from right half
        while (j <= high) {
            temp.push_back(nums[j]);
            j++;
        }

        // Copy back into nums
        for (int k = 0; k < temp.size(); k++) {
            nums[low + k] = temp[k];
        }
    }

    void partitions(vector<int>& nums, int low, int high) {
        if (low >= high) return;

        int mid = low + (high - low) / 2;

        partitions(nums, low, mid);
        partitions(nums, mid + 1, high);

        combine(nums, low, mid, high);
    }

    vector<int> mergeSort(vector<int>& nums) {
        int n = nums.size();

        if (n <= 1) return nums;

        partitions(nums, 0, n - 1);

        return nums;
    }
};
