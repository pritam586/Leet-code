class Solution {
  public:
    int getSecondLargest(vector<int> &arr) {
        // code here
        int largest = INT_MIN;
        for(int  i = 0 ; i< arr.size() ; i++){
            if(arr[i]>largest) {
                largest = arr[i];
            }
        }
        int secLargest  = -1;
        for(int  i = 0 ; i< arr.size() ; i++){
            if(arr[i]>secLargest && arr[i]!=largest) {
                secLargest = arr[i];
            }
        }
        return secLargest;
    }
};
