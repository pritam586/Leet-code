class Solution {
  public:
    void selectionSort(vector<int> &arr) {
        // code here
        int n = arr.size();
        for(int i = 0 ; i<n ; i++){
            int minidx = i;
            for(int j = i ; j<n ; j++){
                if(arr[j]<arr[minidx]){
                    minidx = j; 
                }
                
            }
            if(minidx!=i){
                int temp = arr[i];
                arr[i] = arr[minidx];
                arr[minidx] = temp;
            }
        }
    }
};
